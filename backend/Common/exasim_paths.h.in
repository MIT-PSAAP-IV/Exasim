// exasim_paths.h — generated by CMake (configure_file). Do not edit the .h.
//
// Locates Exasim's installed runtime data (the precomputed master/gauss node
// files) without a user-supplied exasimpath. CMake bakes the install location
// at configure time; $EXASIM_DATA_DIR overrides it for a relocated install.
#pragma once
#include <cstdlib>
#include <string>

#ifndef EXASIM_INSTALL_DATADIR
#define EXASIM_INSTALL_DATADIR "@EXASIM_INSTALL_DATADIR@"
#endif

// Directory containing masternodes.bin / gaussnodes.bin.
inline std::string exasim_data_dir()
{
    const char* e = std::getenv("EXASIM_DATA_DIR");
    if (e && *e) return std::string(e);
    return std::string(EXASIM_INSTALL_DATADIR);
}
