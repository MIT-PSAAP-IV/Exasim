cmake_minimum_required(VERSION 3.16)
project(exasim_frontend_app C CXX)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
# Don't relink exasimapp when libfrontend_model changes — its link interface
# is a single stable C++ function; only the dynamic library is rebuilt.
set(CMAKE_LINK_DEPENDS_NO_SHARED ON)

# Rendered by the Exasim language frontend (cmakecompile) — do not edit.
set(EXASIM_VARIANT "@EXASIM_VARIANT@")  # cpu | cpumpi | gpu | gpumpi

find_package(Exasim REQUIRED COMPONENTS ${EXASIM_VARIANT})
# ExasimConfig.cmake resolves Kokkos from its baked build-time location;
# only search again if that somehow did not produce the target.
if(NOT TARGET Kokkos::kokkos)
  find_package(Kokkos REQUIRED)
endif()

# The frontend gencode step writes the kernel .cpp set into KERNELS; the
# provider library intercepts model ID @MODEL_ID@ and falls through to the
# installed built-in dispatchers for all other IDs. SHARED: the model is a
# dynamic library (libfrontend_model), so model changes relink only the
# small provider — exasimapp itself never relinks.
exasim_add_external_builtin_model(TARGET frontend_model
  ID @MODEL_ID@
  KERNELS "@KERNEL_DIR@"
  SHARED)

add_executable(exasimapp main.cpp)
target_compile_definitions(exasimapp PRIVATE _BUILTINLIBRARY)
# Find libfrontend_model next to the executable wherever the pair is copied
# (per-user model cache); @loader_path is macOS, $ORIGIN is Linux.
set_target_properties(exasimapp PROPERTIES
  BUILD_RPATH "@loader_path;$ORIGIN")
# Export the executable's symbols (Kokkos in particular) so the dynamic
# provider resolves them at load time — one Kokkos runtime overall.
set_target_properties(exasimapp PROPERTIES ENABLE_EXPORTS ON)
target_link_libraries(exasimapp PRIVATE
    Exasim::headers
    Exasim::${EXASIM_VARIANT}lib
    frontend_model
    Kokkos::kokkos)

if(EXASIM_VARIANT MATCHES "mpi")
  find_package(MPI REQUIRED)
  target_compile_definitions(exasimapp PRIVATE _MPI)
  target_link_libraries(exasimapp PRIVATE MPI::MPI_CXX)
  # Record the MPI launcher CMake discovered so the frontend's runcode uses a
  # portable, configure-time path instead of guessing /usr/local/bin/mpirun etc.
  if(MPIEXEC_EXECUTABLE)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/mpiexec.txt" "${MPIEXEC_EXECUTABLE}\n")
  endif()
endif()

message(STATUS
  "Exasim frontend app: ${CMAKE_CURRENT_BINARY_DIR}/exasimapp "
  "(model ID @MODEL_ID@, variant ${EXASIM_VARIANT})")
