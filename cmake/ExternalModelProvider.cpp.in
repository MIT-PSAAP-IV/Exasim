bool IsValidExternalModelABI(const ExasimDriverABI& abi)
{
    return abi.abi_version == kExasimDriverABIVersion &&
           abi.struct_size == sizeof(ExasimDriverABI) &&
           abi.KokkosFlux && abi.KokkosSource && abi.KokkosSourcew && abi.KokkosTdfunc &&
           abi.KokkosAvfield && abi.KokkosEoS && abi.KokkosEoSdu && abi.KokkosEoSdw &&
           abi.KokkosFbou && abi.KokkosUbou && abi.KokkosFbouJac && abi.KokkosUbouJac &&
           abi.KokkosFhat && abi.KokkosUhat && abi.KokkosStab &&
           abi.KokkosOutput && abi.KokkosMonitor &&
           abi.KokkosVisScalars && abi.KokkosVisVectors && abi.KokkosVisTensors &&
           abi.KokkosQoIvolume && abi.KokkosQoIboundary &&
           abi.KokkosInitu && abi.KokkosInitq && abi.KokkosInitudg &&
           abi.KokkosInitwdg && abi.KokkosInitodg &&
           abi.cpuInitu && abi.cpuInitq && abi.cpuInitudg && abi.cpuInitwdg && abi.cpuInitodg &&
           abi.HdgFlux && abi.HdgSource && abi.HdgSourcew && abi.HdgSourcewonly && abi.HdgEoS &&
           abi.HdgFbou && abi.HdgFbouonly && abi.HdgFint && abi.HdgFintonly &&
           abi.HdgFext && abi.HdgFextonly;
}

} // namespace

const ExasimDriverABI& getBuiltInLibraryExasimDriverABI()
{
    static const ExasimDriverABI abi = [] {
        ExasimDriverABI value;
        value.abi_version = kExasimDriverABIVersion;
        value.struct_size = sizeof(ExasimDriverABI);
        value.KokkosFlux        = &extKokkosFlux;
        value.KokkosSource      = &extKokkosSource;
        value.KokkosSourcew     = &extKokkosSourcew;
        value.KokkosTdfunc      = &extKokkosTdfunc;
        value.KokkosAvfield     = &extKokkosAvfield;
        value.KokkosEoS         = &extKokkosEoS;
        value.KokkosEoSdu       = &extKokkosEoSdu;
        value.KokkosEoSdw       = &extKokkosEoSdw;
        value.KokkosFbou        = &extKokkosFbou;
        value.KokkosUbou        = &extKokkosUbou;
        value.KokkosFbouJac     = &extKokkosFbouJac;
        value.KokkosUbouJac     = &extKokkosUbouJac;
        value.KokkosFhat        = &extKokkosFhat;
        value.KokkosUhat        = &extKokkosUhat;
        value.KokkosStab        = &extKokkosStab;
        value.KokkosOutput      = &extKokkosOutput;
        value.KokkosMonitor     = &extKokkosMonitor;
        value.KokkosVisScalars  = &extKokkosVisScalars;
        value.KokkosVisVectors  = &extKokkosVisVectors;
        value.KokkosVisTensors  = &extKokkosVisTensors;
        value.KokkosQoIvolume   = &extKokkosQoIvolume;
        value.KokkosQoIboundary = &extKokkosQoIboundary;
        value.KokkosInitu       = &extKokkosInitu;
        value.KokkosInitq       = &extKokkosInitq;
        value.KokkosInitudg     = &extKokkosInitudg;
        value.KokkosInitwdg     = &extKokkosInitwdg;
        value.KokkosInitodg     = &extKokkosInitodg;
        value.cpuInitu          = &extcpuInitu;
        value.cpuInitq          = &extcpuInitq;
        value.cpuInitudg        = &extcpuInitudg;
        value.cpuInitwdg        = &extcpuInitwdg;
        value.cpuInitodg        = &extcpuInitodg;
        value.HdgFlux           = &extHdgFlux;
        value.HdgSource         = &extHdgSource;
        value.HdgSourcew        = &extHdgSourcew;
        value.HdgSourcewonly    = &extHdgSourcewonly;
        value.HdgEoS            = &extHdgEoS;
        value.HdgFbou           = &extHdgFbou;
        value.HdgFbouonly       = &extHdgFbouonly;
        value.HdgFint           = &extHdgFint;
        value.HdgFintonly       = &extHdgFintonly;
        value.HdgFext           = &extHdgFext;
        value.HdgFextonly       = &extHdgFextonly;
        return value;
    }();
    if (!IsValidExternalModelABI(abi))
        throw std::runtime_error("External model ABI table incomplete (model @EXT_ID@)");
    return abi;
}
