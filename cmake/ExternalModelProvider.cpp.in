// by CMake (configure_file @ONLY). EXASIM_EXT_MODEL_INCLUDES pulls in each
// model<ID>/model.{hpp,cpp}; EXASIM_EXT_MODEL_IDS(X) expands X(id1) X(id2)...
#define EXASIM_BUILTIN_MODEL_IMPL
@EXT_MODEL_INCLUDES@
@EXT_MODEL_IDS_MACRO@

namespace {

// --- Kokkos element kernels ---

void extKokkosFlux(
    dstype* f, const dstype* xdg, const dstype* udg, const dstype* odg,
    const dstype* wdg, const dstype* uinf, const dstype* param, const dstype time,
    const int modelnumber, const int ng, const int nc, const int ncu, const int nd,
    const int ncx, const int nco, const int ncw)
{
#define EXASIM_EXT_DISPATCH(ID) if (modelnumber == (ID)) return exasim_model_##ID::KokkosFlux(f, xdg, udg, odg, wdg, uinf, param, time, modelnumber, ng, nc, ncu, nd, ncx, nco, ncw);
    EXASIM_EXT_MODEL_IDS(EXASIM_EXT_DISPATCH)
#undef EXASIM_EXT_DISPATCH
    ::builtinKokkosFlux(f, xdg, udg, odg, wdg, uinf, param, time, modelnumber,
            ng, nc, ncu, nd, ncx, nco, ncw);
}

