#ifdef EXASIM_HAS_FRONTEND_MODEL_SIZES
const ModelSizes kFrontendModelSizes = {
    exasim_model_sizes::ncu, exasim_model_sizes::nco,
    exasim_model_sizes::ncw, exasim_model_sizes::nsca,
    exasim_model_sizes::nvec, exasim_model_sizes::nten,
    exasim_model_sizes::nsurf, exasim_model_sizes::nvqoi
};
#endif

ModelSizes extGetModelSizes(int modelnumber)
{
    // For text2code-generated models the constexpr sizes from each model's
    // PdeModel struct are exposed by a per-model TU (_model_sizes_<ID>.cpp).
    // For frontend-generated models (KERNELS/KERNELS_DIRS path) the sizes
    // come from model_sizes.hpp (captured in kFrontendModelSizes above).
    // Fall through to builtinGetModelSizes for standard IDs (1-15) and for
    // hand-written models without my_model.hpp.
#if @EXT_MODEL_HAS_MY_MODEL@
#define EXASIM_EXT_CASE(ID) case (ID): return ::extGetModelSizes_##ID();
    switch (modelnumber) {
        EXASIM_EXT_MODEL_IDS(EXASIM_EXT_CASE)
#undef EXASIM_EXT_CASE
        default: return builtinGetModelSizes(modelnumber);
    }
#else
#if defined(EXASIM_HAS_FRONTEND_MODEL_SIZES)
    if (EXASIM_FRONTEND_AGGREGATE_MODEL || modelnumber >= 100)
        return kFrontendModelSizes;
#endif
    return builtinGetModelSizes(modelnumber);
#endif
}

bool IsValidExternalModelABI(const ExasimDriverABI& abi)
{
    return abi.abi_version == kExasimDriverABIVersion &&
           abi.struct_size == sizeof(ExasimDriverABI) &&
           abi.volume.KokkosFlux && abi.volume.KokkosSource && abi.volume.KokkosSourcew && abi.volume.KokkosTdfunc &&
           abi.volume.KokkosAvfield && abi.eos.KokkosEoS && abi.eos.KokkosEoSdu && abi.eos.KokkosEoSdw &&
           abi.boundary.KokkosFbou && abi.boundary.KokkosUbou && abi.boundary.KokkosFbouJac && abi.boundary.KokkosUbouJac &&
           abi.iface.KokkosFhat && abi.iface.KokkosUhat && abi.iface.KokkosStab &&
           abi.output.KokkosOutput && abi.output.KokkosMonitor &&
           abi.output.KokkosVisScalars && abi.output.KokkosVisVectors && abi.output.KokkosVisTensors &&
           abi.qoi.KokkosQoIvolume && abi.qoi.KokkosQoIboundary &&
           abi.init.KokkosInitu && abi.init.KokkosInitq && abi.init.KokkosInitudg &&
           abi.init.KokkosInitwdg && abi.init.KokkosInitodg &&
           abi.init.cpuInitu && abi.init.cpuInitq && abi.init.cpuInitudg && abi.init.cpuInitwdg && abi.init.cpuInitodg &&
           abi.hdgjac.HdgFlux && abi.hdgjac.HdgSource && abi.hdgjac.HdgSourcew && abi.hdgjac.HdgSourcewonly && abi.hdgjac.HdgEoS &&
           abi.hdgjac.HdgFbou && abi.hdgjac.HdgFbouonly && abi.hdgjac.HdgFint && abi.hdgjac.HdgFintonly &&
           abi.hdgjac.HdgFext && abi.hdgjac.HdgFextonly;
}

} // namespace

const ExasimDriverABI& getBuiltInLibraryExasimDriverABI()
{
    static const ExasimDriverABI abi = [] {
        ExasimDriverABI value;
        value.abi_version = kExasimDriverABIVersion;
        value.struct_size = sizeof(ExasimDriverABI);
        value.volume.KokkosFlux        = &extKokkosFlux;
        value.volume.KokkosSource      = &extKokkosSource;
        value.volume.KokkosSourcew     = &extKokkosSourcew;
        value.volume.KokkosTdfunc      = &extKokkosTdfunc;
        value.volume.KokkosAvfield     = &extKokkosAvfield;
        value.eos.KokkosEoS         = &extKokkosEoS;
        value.eos.KokkosEoSdu       = &extKokkosEoSdu;
        value.eos.KokkosEoSdw       = &extKokkosEoSdw;
        value.boundary.KokkosFbou        = &extKokkosFbou;
        value.boundary.KokkosUbou        = &extKokkosUbou;
        value.boundary.KokkosFbouJac     = &extKokkosFbouJac;
        value.boundary.KokkosUbouJac     = &extKokkosUbouJac;
        value.iface.KokkosFhat        = &extKokkosFhat;
        value.iface.KokkosUhat        = &extKokkosUhat;
        value.iface.KokkosStab        = &extKokkosStab;
        value.output.KokkosOutput      = &extKokkosOutput;
        value.output.KokkosMonitor     = &extKokkosMonitor;
        value.output.KokkosVisScalars  = &extKokkosVisScalars;
        value.output.KokkosVisVectors  = &extKokkosVisVectors;
        value.output.KokkosVisTensors  = &extKokkosVisTensors;
        value.qoi.KokkosQoIvolume   = &extKokkosQoIvolume;
        value.qoi.KokkosQoIboundary = &extKokkosQoIboundary;
        value.init.KokkosInitu       = &extKokkosInitu;
        value.init.KokkosInitq       = &extKokkosInitq;
        value.init.KokkosInitudg     = &extKokkosInitudg;
        value.init.KokkosInitwdg     = &extKokkosInitwdg;
        value.init.KokkosInitodg     = &extKokkosInitodg;
        value.init.cpuInitu          = &extcpuInitu;
        value.init.cpuInitq          = &extcpuInitq;
        value.init.cpuInitudg        = &extcpuInitudg;
        value.init.cpuInitwdg        = &extcpuInitwdg;
        value.init.cpuInitodg        = &extcpuInitodg;
        value.hdgjac.HdgFlux           = &extHdgFlux;
        value.hdgjac.HdgSource         = &extHdgSource;
        value.hdgjac.HdgSourcew        = &extHdgSourcew;
        value.hdgjac.HdgSourcewonly    = &extHdgSourcewonly;
        value.hdgjac.HdgEoS            = &extHdgEoS;
        value.hdgjac.HdgFbou           = &extHdgFbou;
        value.hdgjac.HdgFbouonly       = &extHdgFbouonly;
        value.hdgjac.HdgFint           = &extHdgFint;
        value.hdgjac.HdgFintonly       = &extHdgFintonly;
        value.hdgjac.HdgFext           = &extHdgFext;
        value.hdgjac.HdgFextonly       = &extHdgFextonly;
        // Model-owned sizes (PR #33): route external-model dimensions through GetModelSizes.
        value.GetModelSizes = &extGetModelSizes;
        // The exasim_model_sizes:: constants only exist for frontend-generated models that ship
        // model_sizes.hpp; hand-written / builtin-fallthrough external models don't have them, so
        // guard the direct size fields (GetModelSizes above already covers all IDs dynamically).
#ifdef EXASIM_HAS_FRONTEND_MODEL_SIZES
        value.ncu   = exasim_model_sizes::ncu;
        value.nco   = exasim_model_sizes::nco;
        value.ncw   = exasim_model_sizes::ncw;
        value.nsca  = exasim_model_sizes::nsca;
        value.nvec  = exasim_model_sizes::nvec;
        value.nten  = exasim_model_sizes::nten;
        value.nsurf = exasim_model_sizes::nsurf;
        value.nvqoi = exasim_model_sizes::nvqoi;
#endif
        return value;
    }();
    if (!IsValidExternalModelABI(abi))
        throw std::runtime_error("External model ABI table incomplete");
    return abi;
}
