// AUTO-GENERATED by exasim_add_external_builtin_model() — do not edit.
// Provides getBuiltInLibraryExasimDriverABI() that dispatches to one or more
// external models (the IDs listed in EXASIM_EXT_MODEL_IDS) and falls through
// to the installed built-in dispatchers (builtinKokkos*, builtinHdg*,
// builtincpu*) for every other ID. Each model<ID>/model.{hpp,cpp} lives in
// its own exasim_model_<ID> namespace, so several models coexist in this one
// translation unit and one provider ABI table dispatches all of them.
#include <cstdio>
#include <cstdlib>
#include <stdexcept>

#include <driver_abi.hpp>
// Extern-C declarations of the 43 built-in dispatcher functions.
#include <backend/Model/BuiltIn/libbuiltinmodel.hpp>

