        exasim_model_@EXT_ID@::cpuInitq(f, xdg, uinf, param, modelnumber, ng, ncx, nce, npe, ne);
    else
        ::builtincpuInitq(f, xdg, uinf, param, modelnumber, ng, ncx, nce, npe, ne);
}

