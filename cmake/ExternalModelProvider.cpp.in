// AUTO-GENERATED by exasim_add_external_builtin_model() — do not edit.
// Provides getBuiltInLibraryExasimDriverABI() that dispatches to one or more
// external models (the IDs listed in EXASIM_EXT_MODEL_IDS) and falls through
// to the installed built-in dispatchers (builtinKokkos*, builtinHdg*,
// builtincpu*) for every other ID. Each model<ID>/model.{hpp,cpp} lives in
// its own exasim_model_<ID> namespace, so several models coexist in this one
// translation unit and one provider ABI table dispatches all of them.
#include <cstdio>
#include <cstdlib>
#include <stdexcept>

#include <driver_abi.hpp>
// Extern-C declarations of the 43 built-in dispatcher functions.
#include <backend/Model/BuiltIn/libbuiltinmodel.hpp>

// Per-model size query — falls through to the built-in model library's
// auto-generated size table so providers need not duplicate it.
extern ModelSizes builtinGetModelSizes(int modelnumber);

// Per-model namespaces + the X-macro list of registered IDs, both rendered
// by CMake (configure_file @ONLY). EXASIM_EXT_MODEL_INCLUDES pulls in each
// model<ID>/model.{hpp,cpp}; EXASIM_EXT_MODEL_IDS(X) expands X(id1) X(id2)...
#define EXASIM_BUILTIN_MODEL_IMPL
@EXT_MODEL_INCLUDES@
@EXT_MODEL_IDS_MACRO@

// Frontend-generated models produce model_sizes.hpp; make its per-model
// dimension constants available through the ABI so they can be omitted
// from pdeapp.txt.
#if defined(__has_include) && __has_include("model_sizes.hpp")
#include "model_sizes.hpp"
#define EXASIM_HAS_FRONTEND_MODEL_SIZES 1
#endif

// For PDEMODEL-generated models a per-model TU exposes each model's constexpr
// PdeModel sizes via a C-linkage function (see _model_sizes_<ID>.cpp).  Hand-
// written models (SOURCES / KERNELS_DIRS) lack my_model.hpp so EXT_MODEL_HAS_MY_MODEL
// is 0 and the size functions below are omitted — only builtinGetModelSizes is used.
#if @EXT_MODEL_HAS_MY_MODEL@
#define EXASIM_EXT_DECL_SIZE(ID) extern "C" ModelSizes extGetModelSizes_##ID();
EXASIM_EXT_MODEL_IDS(EXASIM_EXT_DECL_SIZE)
#undef EXASIM_EXT_DECL_SIZE
#endif

#define EXASIM_FRONTEND_AGGREGATE_MODEL @EXT_MODEL_FRONTEND_AGGREGATE@
#if EXASIM_FRONTEND_AGGREGATE_MODEL
#define EXASIM_EXT_MATCH(ID, MODELNUMBER) true
#else
#define EXASIM_EXT_MATCH(ID, MODELNUMBER) ((MODELNUMBER) == (ID))
#endif

namespace {

// --- Kokkos element kernels ---

void extKokkosFlux(
    dstype* f, const dstype* xdg, const dstype* udg, const dstype* odg,
    const dstype* wdg, const dstype* uinf, const dstype* param, const dstype time,
    const int modelnumber, const int ng, const int nc, const int ncu, const int nd,
    const int ncx, const int nco, const int ncw)
{
#define EXASIM_EXT_DISPATCH(ID) if (EXASIM_EXT_MATCH(ID, modelnumber)) return exasim_model_##ID::KokkosFlux(f, xdg, udg, odg, wdg, uinf, param, time, modelnumber, ng, nc, ncu, nd, ncx, nco, ncw);
    EXASIM_EXT_MODEL_IDS(EXASIM_EXT_DISPATCH)
#undef EXASIM_EXT_DISPATCH
    ::builtinKokkosFlux(f, xdg, udg, odg, wdg, uinf, param, time, modelnumber,
            ng, nc, ncu, nd, ncx, nco, ncw);
}

