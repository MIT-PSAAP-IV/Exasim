@PACKAGE_INIT@

# Snapshot our own install prefix immediately. @PACKAGE_INIT@ sets
# PACKAGE_PREFIX_DIR to THIS package's prefix, but a nested find_dependency()
# below (e.g. Kokkos, whose own *Config.cmake re-runs @PACKAGE_INIT@) clobbers
# the variable with its prefix. The Exasim_* paths set further down must derive
# from Exasim's prefix, not whatever the last dependency left behind, so we
# capture it here before any find_dependency() runs.
set(_Exasim_PACKAGE_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")

# ---- Git provenance baked in at build time ---------------------------------
# The commit + branch this package was built from. These are always defined;
# they read "unknown" if Exasim was configured outside a git checkout.
set(Exasim_GIT_COMMIT "@EXASIM_GIT_COMMIT@")
set(Exasim_GIT_BRANCH "@EXASIM_GIT_BRANCH@")

# Optional provenance pinning. A consumer may require a specific commit and/or
# branch BEFORE find_package(); each requirement is independent and unset ones
# are not checked:
#
#     set(Exasim_REQUIRE_COMMIT 2bd2dce1)   # full hash, or an abbreviated prefix
#     set(Exasim_REQUIRE_BRANCH master)
#     find_package(Exasim REQUIRED)
#
# A mismatch reports the package as not found via Exasim_NOT_FOUND_MESSAGE: with
# REQUIRED this is a fatal error, otherwise Exasim_FOUND is simply left FALSE.
if(DEFINED Exasim_REQUIRE_COMMIT AND NOT Exasim_REQUIRE_COMMIT STREQUAL "")
  # Prefix match so an abbreviated hash validates against the full one.
  string(FIND "${Exasim_GIT_COMMIT}" "${Exasim_REQUIRE_COMMIT}" _exasim_commit_pos)
  if(NOT _exasim_commit_pos EQUAL 0)
    set(Exasim_FOUND FALSE)
    set(Exasim_NOT_FOUND_MESSAGE
      "Exasim was built from commit ${Exasim_GIT_COMMIT}, but commit '${Exasim_REQUIRE_COMMIT}' was required (set Exasim_REQUIRE_COMMIT).")
    return()
  endif()
endif()
if(DEFINED Exasim_REQUIRE_BRANCH AND NOT Exasim_REQUIRE_BRANCH STREQUAL "")
  if(NOT Exasim_GIT_BRANCH STREQUAL Exasim_REQUIRE_BRANCH)
    set(Exasim_FOUND FALSE)
    set(Exasim_NOT_FOUND_MESSAGE
      "Exasim was built from branch '${Exasim_GIT_BRANCH}', but branch '${Exasim_REQUIRE_BRANCH}' was required (set Exasim_REQUIRE_BRANCH).")
    return()
  endif()
endif()

# ExasimConfig.cmake.in — installed CMake config for Exasim.
#
# Downstream consumer:
#
#     find_package(Exasim REQUIRED)
#     add_executable(my_solver main.cpp)
#     target_link_libraries(my_solver PRIVATE
#         Exasim::headers Exasim::cpumpiprelib)
#
# The package exports:
#   - Exasim::headers      (INTERFACE include target)
#   - Exasim::cpulib       (libcpuEXASIM.a, when built)
#   - Exasim::cpumpilib    (libcpumpiEXASIM.a, when built)
#   - Exasim::cpuprelib    (libcpupreEXASIM.a, when built)
#   - Exasim::cpumpiprelib (libcpumpipreEXASIM.a, when built)
#   - Exasim::gpulib       (libgpuEXASIM.a, when built)
#   - Exasim::gpumpilib    (libgpumpiEXASIM.a, when built)
#   - Exasim::gpuprelib    (libgpupreEXASIM.a, when built)
#   - Exasim::gpumpiprelib (libgpumpipreEXASIM.a, when built)
#
# Each exported library target carries the transitive link interface of its
# solver variant. Kokkos is always required; MPI is required whenever any
# exported MPI library variant is present in the package.

include(CMakeFindDependencyMacro)

set(_EXASIM_KOKKOS_DIR "@Kokkos_DIR@")
if(NOT TARGET Kokkos::kokkos)
  if(EXISTS "${_EXASIM_KOKKOS_DIR}/KokkosConfig.cmake")
    find_package(Kokkos REQUIRED CONFIG
      PATHS "${_EXASIM_KOKKOS_DIR}"
      NO_DEFAULT_PATH)
  elseif(EXISTS "${_EXASIM_KOKKOS_DIR}/lib/cmake/Kokkos/KokkosConfig.cmake")
    find_package(Kokkos REQUIRED CONFIG
      PATHS "${_EXASIM_KOKKOS_DIR}/lib/cmake/Kokkos"
      NO_DEFAULT_PATH)
  else()
    find_dependency(Kokkos REQUIRED)
  endif()
endif()
if(@EXASIM_PACKAGE_HAS_MPI@)
  find_dependency(MPI REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ExasimTargets.cmake")

# ---- External built-in model support paths ---------------------------------
# Available after find_package(Exasim); consumed by ExasimExternalModel.cmake.
#   Exasim_ROOT             — install prefix
#   Exasim_TEXT2CODE_ROOT   — root that text2code expects for backend/ headers;
#                             text2code looks for $exasimpath/backend/... which
#                             in an installed package lives under include/, so
#                             this points to $prefix/include.
#   Exasim_BUILTIN_DIR      — installed backend/Model/BuiltIn/ (model.hpp/model.cpp)
#   Exasim_CMAKE_DIR        — directory of this file (ExternalModelProvider.cpp.in)
#   Exasim_TEXT2CODE        — installed text2code binary (may not exist if not built)
set(Exasim_ROOT             "${_Exasim_PACKAGE_PREFIX_DIR}")
set(Exasim_TEXT2CODE_ROOT   "${_Exasim_PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(Exasim_BUILTIN_DIR      "${_Exasim_PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/backend/Model/BuiltIn")
set(Exasim_CMAKE_DIR        "${CMAKE_CURRENT_LIST_DIR}")
set(Exasim_TEXT2CODE        "${_Exasim_PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/text2code")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ExasimExternalModel.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/ExasimExternalModel.cmake")
endif()

# ---- Variant selection via components --------------------------------------
# Instead of branching on options to pick a target name, consumers request a
# variant:
#
#     find_package(Exasim REQUIRED COMPONENTS cpumpi)
#     target_link_libraries(app PRIVATE
#         Exasim::headers Exasim::pre Exasim::builtinmodel)
#
# Components: cpu, cpumpi, gpu, gpumpi. The package resolves the request to the
# concrete exported targets and provides the stable chooser targets Exasim::pre
# (selected preprocessing library) and Exasim::builtinmodel (matching built-in
# model library). A requested variant that was not built into this install fails
# loudly via check_required_components(). Plain find_package(Exasim) with no
# COMPONENTS still exposes every built target by its explicit name.
set(_exasim_pre_cpu    Exasim::cpuprelib)
set(_exasim_pre_cpumpi Exasim::cpumpiprelib)
set(_exasim_pre_gpu    Exasim::gpuprelib)
set(_exasim_pre_gpumpi Exasim::gpumpiprelib)
set(_exasim_bm_cpu     Exasim::builtinmodelserial)
set(_exasim_bm_cpumpi  Exasim::builtinmodelserial)
if(@EXASIM_HIP@)
  set(_exasim_bm_gpu     Exasim::builtinmodelhip)
  set(_exasim_bm_gpumpi  Exasim::builtinmodelhip)
else()
  set(_exasim_bm_gpu     Exasim::builtinmodelcuda)
  set(_exasim_bm_gpumpi  Exasim::builtinmodelcuda)
endif()

foreach(_c ${Exasim_FIND_COMPONENTS})
  if(_c STREQUAL "petsc")
    # Optional PETSc shim (Exasim::petsc, <exasim/petsc.hpp>): present only if PETSc was found
    # when Exasim was built. The consumer still finds + links its own PETSc.
    if(TARGET Exasim::petsc)
      set(Exasim_petsc_FOUND TRUE)
    else()
      set(Exasim_petsc_FOUND FALSE)
    endif()
  elseif(DEFINED _exasim_pre_${_c} AND TARGET ${_exasim_pre_${_c}})
    set(Exasim_${_c}_FOUND TRUE)
    # First requested variant defines the chooser targets (single-variant case).
    if(NOT TARGET Exasim::pre)
      add_library(Exasim::pre INTERFACE IMPORTED)
      set_target_properties(Exasim::pre PROPERTIES
        INTERFACE_LINK_LIBRARIES "${_exasim_pre_${_c}}")
    endif()
    if(TARGET ${_exasim_bm_${_c}} AND NOT TARGET Exasim::builtinmodel)
      add_library(Exasim::builtinmodel INTERFACE IMPORTED)
      set_target_properties(Exasim::builtinmodel PROPERTIES
        INTERFACE_LINK_LIBRARIES "${_exasim_bm_${_c}}")
    endif()
  else()
    set(Exasim_${_c}_FOUND FALSE)
  endif()
endforeach()

check_required_components(Exasim)
